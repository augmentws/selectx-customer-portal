# PostgreSQL (docker compose)
POSTGRES_USER=customer_portal
POSTGRES_PASSWORD=customer_portal
POSTGRES_DB=customer_portal
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://customer_portal:customer_portal@localhost:5433/customer_portal
TEST_DATABASE_URL=postgresql+psycopg://customer_portal:customer_portal@localhost:5433/customer_portal_test

# Auth — replace with a long random value (python -c 'import secrets;print(secrets.token_urlsafe(48))')
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# First admin, created by: pipenv run python -m app.bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# CORS / BFF
WEB_ORIGIN=http://localhost:3001

# Encryption for stored third-party credentials (comma-separated Fernet keys; first encrypts).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEYS=replace-me

# PestPac: credentials are configured per operator in the app, not here.
# PESTPAC_DEFAULT_BASE_URL=https://api.workwave.com/pestpac/v1
# Logs PestPac request/response bodies (customer data). Local debugging only.
PESTPAC_DEBUG_BODIES=false
# Page size for PestPac pageable endpoints (check PestPac limits before raising)
# PESTPAC_PAGE_SIZE=50

# OpenRouter (LLM data clean-up). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model id used when a task doesn't name one, e.g. provider/model from openrouter.ai/models
OPENROUTER_DEFAULT_MODEL=
# Logs prompts and completions (customer data). Local debugging only.
OPENROUTER_DEBUG_BODIES=false
