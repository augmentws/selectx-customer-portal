# PostgreSQL (docker compose)
POSTGRES_USER=customer_portal
POSTGRES_PASSWORD=customer_portal
POSTGRES_DB=customer_portal
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://customer_portal:customer_portal@localhost:5433/customer_portal
TEST_DATABASE_URL=postgresql+psycopg://customer_portal:customer_portal@localhost:5433/customer_portal_test

# Auth — replace with a long random value (python -c 'import secrets;print(secrets.token_urlsafe(48))')
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# First admin, created by: pipenv run python -m app.bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# CORS / BFF
WEB_ORIGIN=http://localhost:3001

# PestPac integration (app/integrations/pestpac)
PESTPAC_CLIENT_ID=
PESTPAC_CLIENT_SECRET=
PESTPAC_USERNAME=
PESTPAC_PASSWORD=
PESTPAC_TENANT=
PESTPAC_API_KEY=
# PESTPAC_BASE_URL=https://api.workwave.com/pestpac/v1
