# PostgreSQL (docker compose)
POSTGRES_USER=customer_portal
POSTGRES_PASSWORD=customer_portal
POSTGRES_DB=customer_portal
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://customer_portal:customer_portal@localhost:5433/customer_portal
TEST_DATABASE_URL=postgresql+psycopg://customer_portal:customer_portal@localhost:5433/customer_portal_test

# Object storage through the S3 API (MinIO locally). Leave S3_BUCKET empty to skip document
# files. Create the bucket and an app user in MinIO first (see README).
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# PESTPAC_DOCUMENTS_START_DATE=2025-09-25
# DOCUMENT_MAX_BYTES=50000000

# MinIO (docker compose). Console: http://localhost:9001
MINIO_ROOT_USER=customer-portal
MINIO_ROOT_PASSWORD=customer-portal-minio
# Existing host directory for MinIO's data; compose won't create it (mkdir -p .data/minio).
MINIO_DATA_DIR=./.data/minio
# AIStor license file (gitignored if kept in the repo root).
MINIO_LICENSE_FILE=./minio.license
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001

# Auth — replace with a long random value (python -c 'import secrets;print(secrets.token_urlsafe(48))')
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
# Sign-in lockout (defaults): failures per email within the window, then locked this long.
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_MINUTES=15
# LOGIN_LOCK_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# First admin, created by: pipenv run python -m app.bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# CORS / BFF
WEB_ORIGIN=http://localhost:3001

# Encryption for stored third-party credentials (comma-separated Fernet keys; first encrypts).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEYS=replace-me

# GoCanvas: client credentials are configured per operator in the app, not here.
# GOCANVAS_BASE_URL=https://api.gocanvas.com/api/v3

# PestPac: credentials are configured per operator in the app, not here.
# PESTPAC_DEFAULT_BASE_URL=https://api.workwave.com/pestpac/v1
# Logs PestPac request/response bodies (customer data). Local debugging only.
PESTPAC_DEBUG_BODIES=false
# Page size for PestPac pageable endpoints (check PestPac limits before raising)
# PESTPAC_PAGE_SIZE=50
# false: capture webhooks only; the worker doesn't handle them or run syncs, and sync
# requests are refused (409). Everything waits and runs once it's true again.
SYNC_ACTIVE=true

# OpenRouter (LLM data clean-up). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model id used when a task doesn't name one, e.g. provider/model from openrouter.ai/models
OPENROUTER_DEFAULT_MODEL=
# Findings extraction without a report; empty uses OPENROUTER_DEFAULT_MODEL.
FINDINGS_LLM_MODEL=
# Tried once when the findings model gives no valid reply; empty means no second try.
FINDINGS_FALLBACK_MODEL=
# Logs prompts and completions (customer data). Local debugging only.
OPENROUTER_DEBUG_BODIES=false
