# FastAPI base URL, used server-side by the BFF only (never exposed to the browser)
API_URL=http://127.0.0.1:8001

# Dev only: comma-separated hostnames (no scheme or port) allowed to load the dev server's
# assets, e.g. a tunnel. Without them the page doesn't hydrate when opened through it.
ALLOWED_DEV_ORIGINS=

# Comma-separated origins (scheme and host, e.g. https://portal.example.com) the app is also
# served from through a tunnel or proxy, accepted by the CSRF origin check.
APP_ORIGINS=
